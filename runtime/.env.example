# AI Software Company Runtime V1.1 - real / proof model provider configuration
#
# This is an EXAMPLE ONLY. Copy it to `.env` (git-ignored) and fill in a key, OR
# export these variables in your shell. NEVER put a real key in this file or in
# any file that is committed.
#
# The runtime does not read `.env` automatically; use `env $(grep -v '^#' .env | xargs) ai-company ...`
# or simply `export` the variables. The API key is read from the *named* variable
# at call time and is never stored, logged, or written to the audit ledger.

# Which real provider to build. openrouter | openai-compatible | disabled
AI_COMPANY_REAL_PROVIDER=openrouter

# OpenAI-compatible base URL. OpenRouter is the first PROOF configuration.
AI_COMPANY_REAL_BASE_URL=https://openrouter.ai/api/v1

# A free / low-cost model id served by that base URL.
AI_COMPANY_REAL_MODEL=meta-llama/llama-3.3-70b-instruct:free

# The NAME of the environment variable that holds the API key (not the key).
AI_COMPANY_REAL_API_KEY_ENV=OPENROUTER_API_KEY

# Optional tuning.
AI_COMPANY_REAL_TIMEOUT_MS=60000
AI_COMPANY_REAL_MAX_RETRIES=2

# The actual API key. Set this in your environment only - do not commit it.
# OpenRouter free inference is a PROOF provider (NON_SENSITIVE_PROOF_ONLY); it is
# NOT an approved permanent production provider.
OPENROUTER_API_KEY=
