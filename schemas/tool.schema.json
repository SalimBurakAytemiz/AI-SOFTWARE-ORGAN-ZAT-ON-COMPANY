{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-software-company/schemas/tool.schema.json",
  "title": "Tool Registry Entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "category",
    "purpose",
    "official_source",
    "license",
    "status",
    "required",
    "optional",
    "used_by",
    "installation_method",
    "runtime_dependency",
    "trust_level",
    "security_risk",
    "permissions_required",
    "health_check",
    "update_policy",
    "adapter_required",
    "cost_model",
    "known_overlap",
    "notes"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "name": { "type": "string" },
    "category": {
      "type": "string",
      "enum": [
        "vcs",
        "forge",
        "agent-harness",
        "agent-framework",
        "method",
        "code-context",
        "code-review",
        "qa",
        "security",
        "model-ops",
        "observability",
        "infrastructure",
        "ci-cd",
        "secrets",
        "policy",
        "sandbox",
        "automation"
      ]
    },
    "purpose": { "type": "string", "minLength": 10 },
    "official_source": { "type": "string", "format": "uri" },
    "license": { "type": "string" },
    "status": { "type": "string", "enum": ["ADOPTED", "OPTIONAL", "DEFERRED", "REJECTED", "RESEARCH"] },
    "required": { "type": "boolean" },
    "optional": { "type": "boolean" },
    "used_by": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Agent ids or 'platform' / 'ci' / 'human-founder'."
    },
    "installation_method": { "type": "string" },
    "runtime_dependency": { "type": "boolean" },
    "trust_level": { "type": "string", "enum": ["high", "medium", "low", "untrusted"] },
    "security_risk": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
    "permissions_required": { "type": "array", "items": { "type": "string" } },
    "health_check": { "type": "string" },
    "update_policy": { "type": "string" },
    "adapter_required": { "type": "boolean" },
    "cost_model": { "type": "string" },
    "known_overlap": { "type": "array", "items": { "type": "string" } },
    "knowledge_adoption": { "type": "string", "enum": ["ADOPT", "PARTIAL", "REJECT"] },
    "runtime_decision": { "type": "string", "enum": ["ADOPT", "OPTIONAL", "DEFER", "REJECT"] },
    "notes": { "type": "string" }
  }
}
