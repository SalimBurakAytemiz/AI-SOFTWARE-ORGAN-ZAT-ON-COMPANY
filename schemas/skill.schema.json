{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-software-company/schemas/skill.schema.json",
  "title": "Reusable Agent Skill",
  "description": "A reusable, composable capability that agents reference by id. Skills hold engineering method so agent YAML stays about role, model and permissions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "version",
    "summary",
    "when_to_use",
    "procedure",
    "inputs",
    "outputs",
    "quality_checks",
    "failure_modes",
    "risk_level",
    "source_influences",
    "status"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "name": { "type": "string", "minLength": 3 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "summary": { "type": "string", "minLength": 20 },
    "when_to_use": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "when_not_to_use": { "type": "array", "items": { "type": "string" } },
    "procedure": { "type": "array", "minItems": 3, "items": { "type": "string" } },
    "inputs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "outputs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "quality_checks": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "failure_modes": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "risk_level": { "type": "integer", "minimum": 0, "maximum": 5 },
    "tools_touched": { "type": "array", "items": { "type": "string" } },
    "source_influences": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "description": "Third-party projects whose techniques informed this skill. Techniques adapted, not copied."
    },
    "status": { "type": "string", "enum": ["ACTIVE", "DRAFT", "DEFERRED", "DEPRECATED"] },
    "notes": { "type": "string" }
  }
}
