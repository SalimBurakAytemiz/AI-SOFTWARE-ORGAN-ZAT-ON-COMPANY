{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-software-company/schemas/audit-event.schema.json",
  "title": "Audit Event",
  "description": "Canonical record for every significant action taken by an agent, tool or the runtime. Audit everything important.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "timestamp",
    "project",
    "task",
    "agent_id",
    "agent_role",
    "model",
    "tool",
    "capability",
    "action",
    "reason",
    "input_reference",
    "output_reference",
    "risk_level",
    "previous_state",
    "new_state",
    "approval_required",
    "approved_by",
    "approval_timestamp",
    "result",
    "duration",
    "estimated_cost",
    "error"
  ],
  "properties": {
    "event_id": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" },
    "project": { "type": "string" },
    "task": { "type": "string" },
    "agent_id": { "type": "string" },
    "agent_role": { "type": "string" },
    "model": { "type": "string" },
    "tool": { "type": ["string", "null"] },
    "capability": { "type": ["string", "null"] },
    "action": { "type": "string" },
    "reason": { "type": "string" },
    "input_reference": { "type": ["string", "null"] },
    "output_reference": { "type": ["string", "null"] },
    "risk_level": { "type": "integer", "minimum": 0, "maximum": 5 },
    "previous_state": { "type": ["string", "null"] },
    "new_state": { "type": ["string", "null"] },
    "approval_required": { "type": "boolean" },
    "approved_by": { "type": ["string", "null"], "description": "'human-founder' or null. No other value is valid for critical actions." },
    "approval_timestamp": { "type": ["string", "null"], "format": "date-time" },
    "result": { "type": "string", "enum": ["PASS", "FAIL", "BLOCKED", "PENDING", "APPROVAL_REQUIRED", "REJECTED"] },
    "duration": { "type": ["number", "null"], "description": "seconds" },
    "estimated_cost": { "type": ["number", "null"], "description": "USD" },
    "error": { "type": ["string", "null"] }
  }
}
