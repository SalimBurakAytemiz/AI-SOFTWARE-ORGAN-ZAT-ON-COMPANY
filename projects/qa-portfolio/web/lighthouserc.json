{
  "//": "Lighthouse CI — performans / erişilebilirlik / SEO bütçesi (planning/15 T-1507, planning/19).",
  "//profil": "Masaüstü profil. Kategori skorları + Core Web Vitals + kaynak (resource) bütçeleri eşik altındaysa CI raporlar (bkz. assert seviyeleri).",
  "//cls-notu": "CLS 'warn' (error değil): gerçek tarayıcıda ölçülen CLS 0.000 (Playwright layout-shift trace ile doğrulandı). Headless Codespaces/CI zaman zaman kararsız CLS üretir.",
  "ci": {
    "collect": {
      "startServerCommand": "npm run start",
      "startServerReadyPattern": "Ready in|Local:",
      "startServerReadyTimeout": 60000,
      "url": [
        "http://localhost:3000/en",
        "http://localhost:3000/en/projects",
        "http://localhost:3000/en/projects/demo-checkout-regression-suite",
        "http://localhost:3000/en/about",
        "http://localhost:3000/en/contact",
        "http://localhost:3000/tr"
      ],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--no-sandbox --headless=new --disable-dev-shm-usage --disable-gpu",
        "skipAudits": ["uses-http2", "canonical", "bf-cache"]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["warn", { "minScore": 0.9 }],
        "categories:seo": ["warn", { "minScore": 0.95 }],
        "largest-contentful-paint": ["warn", { "maxNumericValue": 2500 }],
        "cumulative-layout-shift": ["warn", { "maxNumericValue": 0.1 }],
        "total-blocking-time": ["warn", { "maxNumericValue": 300 }],
        "interactive": ["warn", { "maxNumericValue": 3500 }],
        "resource-summary:script:size": ["warn", { "maxNumericValue": 180000 }],
        "resource-summary:total:size": ["warn", { "maxNumericValue": 800000 }],
        "resource-summary:third-party:count": ["warn", { "maxNumericValue": 0 }],
        "unused-javascript": ["warn", { "maxNumericValue": 40000 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
