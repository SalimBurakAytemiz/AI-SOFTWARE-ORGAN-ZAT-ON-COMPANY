# QA Portfolio - ortam değişkenleri örneği.
# Bu dosyayı ".env.local" olarak kopyalayın ve gerçek değerleri girin.
# .env.local git tarafından yok sayılır. GERÇEK ANAHTARLARI ASLA COMMIT ETMEYİN.
#
# Supabase kimlik bilgileri girilse bile public site, NEXT_PUBLIC_CONTENT_SOURCE
# "supabase" yapılana kadar placeholder içerikle (src/content/fixtures.ts)
# çalışır. Bu değişkenler boşken de "npm run build" başarılıdır.

# --- Genel ---
# Sitenin kanonik adresi (metadata, sitemap, Open Graph için).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Supabase (public - RLS ile sınırlı, istemciye gömülebilir) ---
# Değerleri Supabase panosundan alın: Project Settings -> API.
#   NEXT_PUBLIC_SUPABASE_URL         -> "Project URL"
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY -> "Publishable key" (eski adıyla "anon key")
# Publishable anahtarın gücü tamamen RLS ile sınırlıdır; tarayıcıya gönderilmesi
# güvenlidir. GİZLİ DEĞİLDİR ama yine de .env.local'de tutulur, commit edilmez.
NEXT_PUBLIC_SUPABASE_URL="YOUR_SUPABASE_PROJECT_URL"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_PUBLISHABLE_KEY"

# Yalnızca migration / tip üretimi için (GİZLİ — DB şifresi içerir, uygulama
# çalışma zamanında KULLANMAZ). Supabase panosu → Project Settings → Database →
# Connection string → "Session pooler" (port 5432). Sadece .env.local'de.
SUPABASE_DB_URL=""

# --- İçerik kaynağı bayrağı (kademeli geçiş kapısı) ---
# "fixtures" (varsayılan): site placeholder içerikle çalışır.
# "supabase": içerik repository'si gerçek Supabase sorgu katmanına geçer.
# YALNIZCA Faz 4 sorgu katmanı + migration + seed hazır olduğunda "supabase" yapın.
NEXT_PUBLIC_CONTENT_SOURCE="fixtures"

# --- Supabase (SADECE SUNUCU - GİZLİ) ---
# RLS'i bypass eden sunucu anahtarı (Supabase'de "service_role key" ya da yeni
# "secret key"). Yalnızca taslak önizleme okuması ve Storage bakım işlemleri için,
# izole sunucu modülünde kullanılır (src/lib/supabase/admin.ts).
# Asla NEXT_PUBLIC_ önekiyle tanımlanmaz, asla istemci paketine girmez.
SUPABASE_SERVICE_ROLE_KEY=""

# --- İletişim formu e-posta bildirimi (SADECE SUNUCU) ---
# Sağlayıcı faz 2'de seçilecek (aday: Resend).
MAIL_PROVIDER_API_KEY=""
MAIL_TO_ADDRESS=""

# --- Harici yeniden doğrulama tetikleyicisi (opsiyonel, SADECE SUNUCU) ---
REVALIDATE_WEBHOOK_SECRET=""

# --- İletişim formu hız sınırı (opsiyonel, ayarlanabilir) ---
CONTACT_RATE_LIMIT_MAX="5"
CONTACT_RATE_LIMIT_WINDOW_SECONDS="3600"
